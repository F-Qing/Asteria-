<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.asteria</groupId>
        <artifactId>asteria</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>asteria-server</artifactId>
    <name>asteria-server</name>
    <description>服务端模块：controller / service / mapper / config / handler，可执行（对应 sky-server）</description>

    <dependencies>
        <!-- 依赖公共模块与模型模块 -->
        <dependency>
            <groupId>com.asteria</groupId>
            <artifactId>asteria-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.asteria</groupId>
            <artifactId>asteria-pojo</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- MyBatis-Plus（Spring Boot 3 专用 starter） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.15</version>
        </dependency>
        <!-- 分页插件依赖（3.5.9+ 必须单独引入 JSqlParser） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.15</version>
        </dependency>

        <!-- MySQL 驱动（版本由 spring-boot 父 POM 管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Apache POI：抽取 .docx 的文本（docx 是 ZIP+XML，不能当纯文本解码） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- Apache PDFBox：抽取 .pdf 的文本（pdf 是二进制格式，同样不能当纯文本解码） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.31</version>
        </dependency>

        <!-- Lombok：日志/构造器简化（版本由 spring-boot 父 POM 管理） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          Spring AI：OpenAI 兼容协议的模型接入。
          一套代码吃 OpenAI / DeepSeek / Moonshot / 通义 / 智谱 / 自建中转站（都能自定义 baseUrl）。
          版本由父 POM 的 spring-ai-bom 管理（1.1.8，对应 Spring Boot 3.5）。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              把前端产物（asteria-ai/dist）打进 jar 的 static/ 目录，让一个 jar 自带前端页面。
              直接拷到 target/classes/static，不动 src/main/resources —— 源目录保持干净，
              也不会把 19MB 的构建产物提交进仓库。
              注意：前端源码改过要先 npm run build，再 mvn package。
              dist 不存在时插件会跳过并打印警告，不会让构建失败。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../asteria-ai/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>